<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>

<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; max-width: 1000px; margin: 20px auto; color: #222;">
  <h2 style="font-size: 1.4em; margin-bottom: 4px;">Inflation Shock Momentum Index (ISMI) — Canada</h2>
  <p style="color: #666; margin-top: 0; font-size: 0.9em;">1991 Q2 – 2026 Q1, disaggregated HFCE categories (StatCan, table 36-10-0124-01)</p>
  <div id="chart" style="width: 100%; height: 550px;">Loading data…</div>
</div>

<script>
  Papa.parse("Data/Canadian_ISMI_data.csv", {
    download: true,
    header: true,
    dynamicTyping: true,
    complete: function(results) {
      const rows = results.data.filter(r => r.date && r.ISMI !== null && r.ISMI !== undefined);

      function quarterToDate(q) {
        if (!q || typeof q !== 'string') return null;
        const match = q.match(/(\d{4})\s*Q([1-4])/i);
        if (!match) return null;
        const year = parseInt(match[1]);
        const month = (parseInt(match[2]) - 1) * 3;
        return new Date(year, month, 1);
      }

      const validRows = rows.map(r => ({
        date: quarterToDate(r.date),
        ismi: r.ISMI,
        pos: r.positive_share,
        neg: r.negative_share
      })).filter(r => r.date !== null);

      const dates = validRows.map(r => r.date);
      const ismi = validRows.map(r => r.ismi);
      const positive = validRows.map(r => r.pos);
      const negative = validRows.map(r => r.neg);

      const traceISMI = {
        x: dates, y: ismi, name: "ISMI",
        type: "scatter", mode: "lines",
        line: { color: "#1f4e79", width: 2 }
      };
      const tracePositive = {
        x: dates, y: positive, name: "Positive share",
        type: "scatter", mode: "lines",
        line: { color: "#c0392b", width: 1, dash: "dot" },
        visible: "legendonly"
      };
      const traceNegative = {
        x: dates, y: negative, name: "Negative share",
        type: "scatter", mode: "lines",
        line: { color: "#2874a6", width: 1, dash: "dot" },
        visible: "legendonly"
      };

      const layout = {
        xaxis: { title: "", rangeslider: { visible: true }, type: "date" },
        yaxis: { title: "ISMI (positive share − negative share)", zeroline: true },
        legend: { orientation: "h", y: 1.15 },
        margin: { t: 30 },
        shapes: [{
          type: "line", x0: dates[0], x1: dates[dates.length - 1],
          y0: 0, y1: 0, line: { color: "grey", width: 1, dash: "dot" }
        }]
      };

      Plotly.newPlot("chart", [traceISMI, tracePositive, traceNegative], layout, { responsive: true });
    },
    error: function(err) {
      document.getElementById("chart").innerText =
        "Could not load Data/Canadian_ISMI_data.csv — check file location.";
    }
  });
</script>
